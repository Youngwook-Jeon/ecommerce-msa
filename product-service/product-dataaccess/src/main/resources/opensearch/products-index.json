{
  "settings": {
    "number_of_shards": 2,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "product_text": {
          "type": "custom",
          "tokenizer": "nori_tokenizer",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": { "type": "keyword" },
      "categoryId": { "type": "long" },
      "name": { "type": "text", "analyzer": "product_text" },
      "brand": { "type": "text", "analyzer": "product_text" },
      "brandKey": { "type": "keyword" },
      "brandLabel": { "type": "keyword" },
      "description": { "type": "text", "analyzer": "product_text" },
      "mainImageUrl": { "type": "keyword", "index": false },
      "basePrice": { "type": "scaled_float", "scaling_factor": 100 },
      "productStatus": { "type": "keyword" },
      "categoryStatus": { "type": "keyword" },
      "createdAt": { "type": "date" }
    }
  }
}
