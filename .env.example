# Copy to .env and adjust. Loaded by workspace scripts / Makefile (set -a; source).
#   cp .env.example .env

# --- Product image storage (Cloudflare R2) ---
# Local default: disabled (no Cloudflare credentials required for make up).
R2_ENABLED=false
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://...

# --- Payment provider ---
# stub (default): no Stripe keys needed
# stripe: set STRIPE_API_KEY only. Webhook secret is fetched automatically by
#   make apps / make up via `stripe listen --print-secret` (CLI whsec; not Dashboard).
#   Background `stripe listen` is started for you; make down stops it.
PAYMENT_PROVIDER=stub
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=   # optional override; leave unset to auto-inject
# Provider webhook inbox reconciliation (optional)
# PAYMENT_PROVIDER_WEBHOOK_INBOX_DELAY_MS=1000
# PAYMENT_PROVIDER_WEBHOOK_INBOX_INITIAL_RETRY_DELAY_MS=5000
# PAYMENT_PROVIDER_WEBHOOK_INBOX_MAX_RETRY_DELAY_MS=300000
# PAYMENT_PROVIDER_WEBHOOK_INBOX_MAX_ATTEMPTS=20

# Optional gateway URL overrides
# PRODUCT_SERVICE_URL=http://localhost:9002
# ORDER_SERVICE_URL=http://localhost:9003
# PAYMENT_SERVICE_URL=http://localhost:9004
