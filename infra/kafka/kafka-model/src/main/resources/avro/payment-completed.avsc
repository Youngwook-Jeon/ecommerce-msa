{
  "namespace": "com.project.young.kafka.payment.avro.model",
  "type": "record",
  "name": "PaymentCompletedAvroModel",
  "doc": "Emitted when payment succeeds. Mirrors payments.payment_outbox row for polling relay.",
  "fields": [
    {
      "name": "eventId",
      "type": { "type": "string", "avro.java.string": "String" }
    },
    {
      "name": "paymentId",
      "type": { "type": "string", "avro.java.string": "String" }
    },
    {
      "name": "orderId",
      "type": { "type": "string", "avro.java.string": "String" }
    },
    {
      "name": "userId",
      "type": { "type": "string", "avro.java.string": "String" }
    },
    {
      "name": "amount",
      "type": { "type": "string", "avro.java.string": "String" }
    },
    {
      "name": "currency",
      "type": { "type": "string", "avro.java.string": "String" },
      "default": "KRW"
    },
    {
      "name": "occurredAt",
      "type": "long"
    }
  ]
}
